# Example terraform.tfvars file for SentinelOps AWS Deployment
aws_region          = "us-east-1"
environment         = "production"

# VPC Configuration
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs= ["10.0.10.0/24", "10.0.20.0/24"]
availability_zones  = ["us-east-1a", "us-east-1b"]

# GPU Compute Configuration (EC2 Spot g5.xlarge = NVIDIA A10G 24GB)
ec2_instance_type   = "g5.xlarge"
ec2_key_name        = "" # Leave empty to connect via AWS Session Manager (recommended), or enter an existing key pair name
admin_cidr_blocks   = ["203.0.113.50/32"] # Replace with your IP for secure SSH access

# RDS PostgreSQL pgvector Configuration
db_name             = "sentinelops_runbooks"
db_username         = "sentinel_admin"
db_password         = "ChangeMeToAStrongPassword123!"
db_instance_class   = "db.t4g.medium"
